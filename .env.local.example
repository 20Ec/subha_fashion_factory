# ------------------------------------------------------------------
#  Copy this file to .env.local and fill in your real values.
#  Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public site config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle

# ------------------------------------------------------------------
#  Optional — only needed for the automated database setup:
#    npm run db:setup
#  Create a token at https://supabase.com/dashboard/account/tokens
#  Remove the line after the database is set up.
# ------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
